# Strix - copy to .env (dev) or /etc/strix/strix.env (prod).
# Never commit real values. Keep comments on their own lines.

# development | production
NODE_ENV=development
PORT=3000
# default HOST: 0.0.0.0 in dev, 127.0.0.1 in production (behind Caddy)
# HOST=127.0.0.1

# prod: https://your.domain  (Google redirect URI = PUBLIC_URL/api/auth/google/callback)
# dev with Vite + real Google login: http://localhost:5173
PUBLIC_URL=http://localhost:3000
# 1 behind Caddy so rate limits see the real client IP
TRUST_PROXY=0
# >= 32 random chars, required in production (openssl rand -base64 48)
SESSION_SECRET=
# extra origins allowed for POST/PUT/DELETE (comma list); the Vite dev origin is fine to keep here
ALLOWED_ORIGINS=http://localhost:5173
# DB_FILE=data/app.db
# WEB_DIST=web/dist

# Google OAuth (scopes: openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# comma list; admins skip the invite step
ADMIN_EMAILS=you@gmail.com

# Dev-only fake login: GET /api/auth/dev-login?email=a@b.c[&name=..][&redirect=/]
# The server REFUSES TO START if DEV_FAKE_LOGIN=1 together with NODE_ENV=production.
DEV_FAKE_LOGIN=0
DEV_FAKE_EMAIL=dev.user@example.com
DEV_FAKE_NAME=Dev User

# Providers (server-side only, never sent to the browser)
OPENROUTER_API_KEY=
# the ONE LLM model for everything (clients cannot choose a model)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# small fast model for duplex turn-taking decisions (POST /api/chat/decide), routed by latency; locked server-side.
# Default deepseek/deepseek-v4.1-flash (benchmark 2026-10: most accurate + fastest of the cheap models); on failure the chat model is tried
# OPENROUTER_DECISION_MODEL=deepseek/deepseek-v4.1-flash
# optional web-search engine for POST /api/persona/assist (default: OpenRouter's choice = Exa for this model)
# PERSONA_WEB_ENGINE=exa
# optional engine for the chat web_search tool (defaults to PERSONA_WEB_ENGINE, then OpenRouter's choice)
# CHAT_WEB_ENGINE=exa
# OPENROUTER_PROVIDER_ORDER=baseten/fp8,modal,coreweave/fp8
# latency | throughput | price | none
# OPENROUTER_PROVIDER_SORT=latency
# key permissions: voices_read + text_to_speech + speech_to_speech (Voice Changer); voices_write is needed for cloning
ELEVENLABS_API_KEY=
# TTS is locked to eleven_v4_turbo (ELEVENLABS_MODEL is ignored). v4 turbo can't do speech-to-speech,
# so the Voice Changer uses this fixed STS model:
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
# account voices every active user may use (comma list; empty = none). Default: the built-in persona (Strix) voice
# SHARED_VOICE_IDS=FjsOoJ0RVxWEQK4p2Wzq,roYauZ4bOLAKvVZTPLre
# display names shown to users instead of the ElevenLabs account name ("id:Name,id2:Name 2" or JSON {"id":"Name"})
# SHARED_VOICE_NAMES=FjsOoJ0RVxWEQK4p2Wzq:Strix,roYauZ4bOLAKvVZTPLre:Lena
ELEVENLABS_MAX_CONCURRENT=3

# Per-user quotas (daily reset 00:00 UTC); admins can override per user
QUOTA_LLM_REQ_PER_DAY=300
QUOTA_TTS_CHARS_PER_DAY=30000
MAX_CLONES_PER_USER=2
# library voices a user can add to their collection
MAX_COLLECTION=50
MAX_CLONE_UPLOAD_MB=10
# Voice Changer: seconds of input audio per day, and max upload size per file (input max 5 minutes)
QUOTA_VC_SEC_PER_DAY=600
MAX_VC_UPLOAD_MB=15
# Mic speech-to-text (ElevenLabs Scribe Realtime, browser streams directly with a single-use token; key needs speech_to_text)
# seconds of mic audio per day, and max seconds per session (one token)
QUOTA_STT_SEC_PER_DAY=1800
# STT_MAX_SESSION_SEC=300
# chat web_search tool executions per user per day (0 = tool disabled)
QUOTA_SEARCH_PER_DAY=50
# /api/chat/decide calls per user per day (NOT counted as LLM requests) and per minute
QUOTA_DECIDE_PER_DAY=3000
# RATE_DECIDE_PER_MIN=120
# persona memory summaries (POST /api/memory/commit, decision model, NOT counted as LLM requests): per user per day and per minute
QUOTA_MEMORY_PER_DAY=500
# RATE_MEMORY_PER_MIN=30

# group calls (#/duo, server/duo.ts): persona replies per call (each = 1 LLM request), personas on one call besides the user,
# persona calls (POST /api/duo/ring, each also = 1 LLM request) per user per day (admin override callPerDay)
# DUO_MAX_PERSONA_TURNS=60
# DUO_MAX_PERSONAS=3
# persona lines in a row without the user (when the user is quiet; right after the user ~3), and seconds without any
# user input before one persona wraps the call up politely
# DUO_MAX_CHAIN=6
# DUO_IDLE_CLOSE_SEC=180
DUO_MAX_CALLS_PER_DAY=40
# regional host (must be *.elevenlabs.io); CSP connect-src allows only wss://<this host>
# ELEVENLABS_STT_HOST=api.elevenlabs.io

# IP rate limits per minute (global for /api, and auth/redeem routes)
RATE_GLOBAL_PER_MIN=120
RATE_AUTH_PER_MIN=20
# LOG_LEVEL=info

# Day this closed test ends (YYYY-MM-DD). Shown on the login page, in the first-entry notice and in the account sheet. Default 2026-10-20.
# TEST_END_DATE=2026-10-20
# After the end of that day (Jakarta time) every page shows the quiet closing page (web/public/end) and /api returns 410. Preview it any time at /end/; rehearse the whole thing with FORCE_CLOSED=1.
